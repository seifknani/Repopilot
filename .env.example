# Copy to .env (git-ignored) and fill in. Never commit a real key.
GROQ_API_KEY=
REPOPILOT_LLM_MODEL=openai/gpt-oss-120b
REPOPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# USD per million tokens, from the provider's current price list (used for the cost model)
REPOPILOT_LLM_PRICE_IN=
REPOPILOT_LLM_PRICE_OUT=
