# Copy to .env (git-ignored) and fill in. Never commit a real key.
GROQ_API_KEY=
REPOPILOT_LLM_MODEL=openai/gpt-oss-120b
REPOPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# USD per million tokens, from the provider's current price list (used for the cost model)
REPOPILOT_LLM_PRICE_IN=
REPOPILOT_LLM_PRICE_OUT=

# Target repository on GitHub: issues are the agent's tasks (scripts/seed_issues.py, scripts/run_issue.py)
REPOPILOT_TARGET_REMOTE=https://github.com/seifknani/task-management-api
# Fine-grained token, only the target repo, "Issues: read and write". Needed to create issues and comment.
GITHUB_TOKEN=

# LangSmith tracing of the LangGraph loop (off unless LANGSMITH_TRACING=true and a key is set).
# Traces contain repository code and test output; they are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repopilot
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only
