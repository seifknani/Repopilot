# Copy to .env (git-ignored) and fill in. Never commit a real key.

# --- LLM provider -------------------------------------------------------------------------------
# OpenAI (default). Precedence: REPOPILOT_LLM_API_KEY > OPENAI_API_KEY > GROQ_API_KEY.
OPENAI_API_KEY=
# gpt-5-mini: $0.25 in / $0.025 cached / $2.00 out per 1M tokens (agent/llm.py MODEL_PRICES).
# Cheaper fallback for bulk eval: gpt-5-nano ($0.05 / $0.005 / $0.40).
REPOPILOT_LLM_MODEL=gpt-5-mini
# Reasoning tokens are billed as output; "low" keeps them small, "minimal" is cheaper still.
REPOPILOT_LLM_REASONING_EFFORT=low
# "flex" = half price, slower and may queue: use it for eval batches, leave empty for live demos.
REPOPILOT_LLM_SERVICE_TIER=
REPOPILOT_LLM_MAX_OUTPUT_TOKENS=2048
# Optional price override (USD per 1M tokens) for models not in MODEL_PRICES:
# REPOPILOT_LLM_PRICE_IN=  REPOPILOT_LLM_PRICE_CACHED=  REPOPILOT_LLM_PRICE_OUT=
# Previous provider (Groq free tier: requests too large, HTTP 413):
# GROQ_API_KEY=
# REPOPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# REPOPILOT_LLM_MODEL=openai/gpt-oss-120b

# --- Spending guards -------------------------------------------------------------------------------
# One run stops at this cost; all runs together stop at the budget (ledger: logs/spend.jsonl).
# Also set a hard monthly limit on the OpenAI project: it is the authoritative cap.
REPOPILOT_MAX_COST_PER_RUN=0.25
REPOPILOT_BUDGET_USD=18

# Gemini (Google AI Studio key; takes precedence over OPENAI_API_KEY). OpenAI-compatible endpoint,
# default model gemini-3.5-flash-lite ($0.30 / $2.50 per 1M tokens on the paid tier, free on the free tier).
GEMINI_API_KEY=

# Target repository on GitHub: issues are the agent's tasks (scripts/seed_issues.py, scripts/run_issue.py)
REPOPILOT_TARGET_REMOTE=https://github.com/seifknani/task-management-api
# Fine-grained token, only the target repo, "Issues: read and write". Needed to create issues, comment,
# and for the UI watch mode's progress labels (repopilot:in-progress/done/failed).
GITHUB_TOKEN=

# LangSmith tracing of the LangGraph loop (off unless LANGSMITH_TRACING=true and a key is set).
# Traces contain repository code and test output; they are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repopilot
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only
